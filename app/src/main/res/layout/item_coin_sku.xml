<?xml version="1.0" encoding="utf-8"?>
<!-- 充值档位卡（金币面板 2 列网格用）：金币数大字 + 角标（可无）+ 价格 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/track"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- 金币数 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coin"
                app:tint="@color/coinText" />

            <TextView
                android:id="@+id/textSkuCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="68"
                android:textColor="@color/coinText"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="金币"
            android:textColor="@color/textSecondary"
            android:textSize="10sp" />

        <!-- 角标（超值 / 最划算）；无角标档位置 INVISIBLE 占位，保证网格内卡片等高 -->
        <TextView
            android:id="@+id/textSkuTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_sku_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="超值"
            android:textColor="@color/onPrimary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/textSkuPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="¥6"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
