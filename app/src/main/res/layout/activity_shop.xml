<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="‹ 返回"
            android:textColor="@color/textSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="道具商店"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="56dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 金币余额 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/track"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 上排：金币图标 + 数字列（独占剩余宽度，99999 也不挤） + 充值加号独立成列 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_coin" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textCoinCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="0"
                                    android:textColor="@color/coinText"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="26sp"
                                    app:autoSizeMinTextSize="14sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="金币"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progressNextCoin"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                android:progressBackgroundTint="@color/track"
                                android:progressTint="@color/coinText" />

                            <TextView
                                android:id="@+id/textRateHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="App 在前台时每满 1 分钟 +1 金币"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 充值入口：主色圆形加号，独立一列，不再挤压数字 -->
                        <ImageButton
                            android:id="@+id/btnBuyCoins"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_coin_plus"
                            android:contentDescription="充值金币"
                            android:src="@drawable/ic_coin_add"
                            app:tint="@color/onPrimary" />
                    </LinearLayout>

                    <!-- 下排：看广告赚金币（广告 SDK 接入中，先模拟）通栏入口 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatchAd"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:text="🎬 看视频广告 +10 金币"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片补给：每小时随机刷新，每张限购 1 次 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片补给"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCardRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 后刷新"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <!-- 手动刷新：花 30 金币立刻换一批补给卡 -->
                <ImageButton
                    android:id="@+id/btnRefreshCards"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="花费金币立即刷新补给"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="每小时随机上架 5 张卡，每张限购 1 次；点 ⟳ 可花 30 金币立即换一批"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/cardShopRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 商店 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="道具商店"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 道具网格：3 列竖版小卡 -->
            <GridLayout
                android:id="@+id/shopList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3" />

            <TextView
                android:id="@+id/textShopEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/surface"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingVertical="40dp"
                android:text="道具还在设计中，敬请期待\n金币先攒着，不会少"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <!-- 背包 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="我的背包"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 背包网格：3 列竖版小卡 -->
            <GridLayout
                android:id="@+id/bagList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3" />

            <TextView
                android:id="@+id/textBagEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/surface"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingVertical="40dp"
                android:text="背包空空如也\n购买的道具会放在这里"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
